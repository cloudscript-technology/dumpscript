# =============================================
# ClickHouse -> S3 local (RustFS, offline)
# =============================================
# Nada aqui é credencial real: RustFS (S3) e ClickHouse sobem no próprio compose.

# --- RustFS (S3-compatible, substituto do MinIO) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
S3_BUCKET=dumpscript
S3_PREFIX=clickhouse/demo

# --- ClickHouse ---
# Mesma tag usada em produção no cliente de referência
CLICKHOUSE_VERSION=26.8.10.6
DB_PORT=8123
# Usuário de backup criado por initdb/01-seed.sql (grants BACKUP, SHOW, S3)
DB_USER=backup
DB_PASSWORD=backup-secret

# Banco a copiar. Vazio = instância inteira (bancos + users/roles/grants/named collections)
DB_NAME=demo

# --- Backup ---
PERIODICITY=daily
RETENTION_DAYS=7
# Vira a cláusula SETTINGS do BACKUP (opcional)
DUMP_OPTIONS=
# tar | tar.gz | tar.zst
CLICKHOUSE_ARCHIVE_FORMAT=tar.zst
CLICKHOUSE_BACKUP_POLL_INTERVAL=3
# Incremental: periodicidade cujo archive mais recente vira o base_backup dos demais
# (ex.: weekly = full; daily = incremental contra o weekly). Vazio = sempre full.
# O cenário completo está em `npm run test:clickhouse:incremental`.
CLICKHOUSE_BASE_BACKUP_PERIODICITY=

# --- Opcional: testar contra o GCS real (HMAC key da sua Service Account) ---
# O UPLOAD é feito pelo servidor ClickHouse (não pelo job), então este teste
# valida o caminho usado em produção. O bucket precisa existir.
# AWS_S3_ENDPOINT_URL=https://storage.googleapis.com
# AWS_ACCESS_KEY_ID=GOOG1E...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-central1
# S3_BUCKET=<bucket-existente>
# S3_PREFIX=clickhouse/local-test
